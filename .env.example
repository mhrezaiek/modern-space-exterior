# ─────────────────────────────────────────────────────────
# MODERN SPACE EXTERIOR — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` to version control.
# ─────────────────────────────────────────────────────────

# Public site URL (used in sitemap, canonical, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.modernspaceexterior.com

# Business contact (real values already wired into <BusinessConfig>; these
# are surfaced for analytics/CRM integrations and the lead form).
NEXT_PUBLIC_BUSINESS_PHONE=+12895525404
NEXT_PUBLIC_BUSINESS_EMAIL=info@modernspaceexterior.com

# ── Lead form: email forwarding (Resend recommended) ────
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=
LEAD_FORM_TO_EMAIL=info@modernspaceexterior.com
LEAD_FORM_FROM_EMAIL=leads@modernspaceexterior.com

# ── Optional: Slack webhook for instant lead alerts ─────
SLACK_LEAD_WEBHOOK_URL=

# ── Anti-spam (Cloudflare Turnstile) ────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics ───────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=modernspaceexterior.com
NEXT_PUBLIC_GTM_ID=

# ── Google Maps embed (used on Contact page) ────────────
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
